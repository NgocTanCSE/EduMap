# =====================================================
# EduMap Hugging Face Deployment Environment Variables
# =====================================================

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# For Hugging Face Spaces, you can use:
# 1. External PostgreSQL (recommended for production)
# 2. SQLite for testing (not recommended for production)

# Option 1: External PostgreSQL (recommended)
DATABASE_URL=postgresql://postgres:password@localhost:5432/edumap

# Option 2: SQLite for testing (not recommended)
# DATABASE_URL=sqlite:///./edumap.db

# PostgreSQL credentials (if using external database)
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=edumap
DB_HOST=localhost
DB_PORT=5432

# =====================================================
# REDIS CONFIGURATION
# =====================================================
# For Hugging Face Spaces, you can use:
# 1. External Redis (recommended for production)
# 2. In-memory caching (not recommended for production)

# Option 1: External Redis (recommended)
REDIS_URL=redis://localhost:6379

# Option 2: In-memory caching (not recommended)
# REDIS_URL=memory://

# Redis credentials (if using external Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =====================================================
# AI SERVICE CONFIGURATION
# =====================================================
# Gemini API Key (required for AI features)
GEMINI_API_KEY=your-gemini-api-key-here

# AI Service configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# =====================================================
# JWT CONFIGURATION
# =====================================================
# JWT Secret for authentication (change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# =====================================================
# STORAGE CONFIGURATION
# =====================================================
# MinIO/S3 configuration (optional for Hugging Face)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=edumap
MINIO_USE_SSL=false

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
# Application ports
PORT=3000
FRONTEND_PORT=3001
AI_SERVICE_PORT=8000

# Application URLs (update for Hugging Face deployment)
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
AI_API_URL=http://localhost:8000/api/ai

# =====================================================
# SENTRY CONFIGURATION (Optional)
# =====================================================
# Sentry DSN for error tracking (optional)
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
SENTRY_DSN_AI=

# =====================================================
# HUGGING FACE SPECIFIC CONFIGURATION
# =====================================================
# HF Spaces configuration
HF_SPACE_TYPE=docker
HF_SPACE_SDK=docker

# HF Token (for private spaces)
HF_TOKEN=

# =====================================================
# FRONTEND CONFIGURATION
# =====================================================
# Frontend API endpoints
NEXT_PUBLIC_API_URL=http://backend:3000/api
NEXT_PUBLIC_AI_API_URL=http://ai-service:8000/api/ai

# =====================================================
# DEVELOPMENT CONFIGURATION
# =====================================================
# Node.js environment
NODE_ENV=production

# Python environment
PYTHON_ENV=production

# Debug mode (disable in production!)
DEBUG=false
VERBOSE=false

# =====================================================
# CORS CONFIGURATION
# =====================================================
# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =====================================================
# RATE LIMITING CONFIGURATION
# =====================================================
# Rate limiting (requests per minute)
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# =====================================================
# LOGGING CONFIGURATION
# =====================================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log format (json, text)
LOG_FORMAT=json

# =====================================================
# DEPLOYMENT CONFIGURATION
# =====================================================
# Hugging Face Spaces deployment
HF_DEPLOYMENT_MODE=docker
HF_RESOURCE_SIZE=cpu-basic
HF_SLEEP_TIMEOUT=3600

# =====================================================
# SECURITY CONFIGURATION
# =====================================================
# Helmet security headers
HELMET_ENABLED=true

# CSRF protection
CSRF_ENABLED=true

# Rate limiting
RATE_LIMIT_ENABLED=true
