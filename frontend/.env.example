# ==========================================
# EduMap Frontend — biến môi trường
# ==========================================
# File này là TEMPLATE. Giá trị thật đặt ở:
#   • Vercel  → Project → Settings → Environment Variables (xem deploy/vercel.env.example)
#   • Máy dev → `frontend/.env.local` (đã gitignore) khi chạy `next dev`
#
# Frontend là Next.js + BFF (`app/api/**`); backend (Rust) và ai-service
# (FastAPI) chạy nơi khác (Render / Docker), KHÔNG deploy lên Vercel.

# --- Bắt buộc --------------------------------------------------------------
# Rust backend. next.config.js rewrites + src/lib/api-config.ts dùng biến này.
BACKEND_URL=https://edumap-api.onrender.com

# FastAPI ai-service (chat proxy, learning-path, …).
AI_SERVICE_URL=https://edumap-ai.onrender.com

# PHẢI trùng JWT_SECRET của backend (src/lib/auth-utils.ts verify chữ ký).
JWT_SECRET=

# --- Tuỳ chọn --------------------------------------------------------------
# Fallback: `src/mock/install.ts` trả về mock nếu cài đặt nhân bản này,
# unset hoặc `true` = dùng mock. production thì set false.
NEXT_PUBLIC_USE_MOCK_API=true

# Bật route /api/auth/dev-login. Ở production route trả 404 nếu khác "true".
ENABLE_DEV_LOGIN=true

# Google Identity Services: chỉ cần client id (không cần client secret).
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Fallback dữ liệu việc làm / sự kiện khi backend không trả về.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
TICKETMASTER_API_KEY=

# Monitoring.
NEXT_PUBLIC_SENTRY_DSN=

# --- Bản đồ ---------------------------------------------------------------
# KEY cho CARTO basemap, bắt buộc.
# Lấy tại https://carto.com/basemaps/apikey/ (free tier 5M requests/tháng)
# Sau đó set vào Vercel → Deployment → Settings → Environment Variables.
# Khi chưa set, server CARTO trả tile không key (vẫn không có label Trung
# Quốc, tuyệt đối không quay lại OpenStreetMap).
NEXT_PUBLIC_CARTO_API_KEY=

# --- Thông báo (tuỳ chọn) -------------------------------------------------
# `true` → Toaster hiện toast ở layout. Mặc định tắt (false).
NEXT_PUBLIC_TOASTS_ENABLED=

# --- AI service BFF (tuỳ chọn) --------------------------------------------
# URL tương đối mặc định `/api/ai` (hầu hết trường hợp chỉ cần để
# `src/services/search.service.ts` có giá trị fallback).
NEXT_PUBLIC_AI_API_URL=/api/ai

# --- Chỉ dùng khi chạy `next dev` local ------------------------------------
# Client phải gọi same-origin (`/api`); URL tuyệt đối bị inline vào bundle.
NEXT_PUBLIC_API_URL=/api
PORT=3000
