# ==========================================
# EduMap Frontend Environment Configuration
# ==========================================

# 1. Kết nối Backend (Chọn 1 trong 2):
# Lựa chọn A (Khuyến nghị cho bạn): Gọi thẳng vào Production Backend trên Hugging Face Spaces
# Không cần cài PostgreSQL, Redis, Python hay NestJS gì cả — chỉ chạy mỗi frontend là dùng được toàn bộ tính năng!
BACKEND_URL=https://tancse2005-edumap.hf.space

# Lựa chọn B: Nếu máy bạn có chạy backend NestJS local ở cổng 3000:
# BACKEND_URL=http://127.0.0.1:3000

# 2. Cổng chạy Next.js (Mặc định 3000 hoặc 7680):
PORT=3000

# 3. Google OAuth Client ID (Tùy chọn nếu cần đăng nhập Google):
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

