# Build context optimization — these paths are NOT needed by the root Dockerfile
# (which only COPYs backend/, frontend/, ai-service/, scripts/,
#  infrastructure/, and seed_crawled_data.sql directly).

# VCS
.git
.gitattributes
.gitignore
.github

# Build artifacts (rebuilt inside Docker — never copy pre-built to image)
**/.next
frontend/.next
backend/dist
**/*.tsbuildinfo

# node_modules (rebuilt inside Docker via npm ci)
**/node_modules

# Local DB backups (never needed in the image)
**/*.bak*
frontend/public/edumap.db.bak-realdata

# Development data (large, not needed in Docker image)
crawled_data/*
!crawled_data/dongnai_unis.json
data_raw
osrm-data
seed_crawled_data.sql

# Unreferenced static assets (not imported anywhere in code) — reduce image size
frontend/public/edumap-promo.mp4

# Documentation (not needed at runtime in the container)
docs

# Testing & planning
.kilo
tests
api

# Mobile (separate deployment)
mobile

# NOTE: crawlers/ is NOT excluded — the crawler Dockerfile (crawlers/Dockerfile,
# build context = repo root) COPYs crawlers/crontab + crawlers/entrypoint.sh.
# The root Dockerfile only COPYs backend/frontend/ai-service/scripts/... so
# including crawlers/ in the context is harmless for the root image build.

# ── Stale files (removed from repo but may persist on HF Space) ──
# `hf upload` never deletes files, so old/deleted files can linger on HF Space
# and get picked up by Docker COPY. These patterns exclude them from build context.
backend/src/services/google-ai.service.ts
backend/backup_modules/
ai-service/app/
aggressive_fix.py

# Frontend orphans: files deleted from git that still exist on the Space.
# Next.js type-checks EVERY file matched by tsconfig's include "**/*.ts(x)",
# so one orphan importing a removed package fails the build even though
# nothing imports it (2026-11-01: components/AgentationToolbar.tsx →
# "Cannot find module 'agentation'"). `frontend/scripts/strip-stale-sources.js`
# (npm `prebuild`) also deletes these inside the image — this is layer 2.
frontend/components/AgentationToolbar.tsx
frontend/components/Header.tsx
frontend/components/Footer.tsx
frontend/components/MobileNav.tsx
frontend/components/TopBar.tsx
frontend/lib/theme.ts
frontend/src/lib/plain-text.ts
frontend/src/services/admin.service.ts
frontend/src/services/analytics.service.ts
frontend/src/services/dashboard.service.ts
frontend/src/services/gamification.service.ts
frontend/src/services/mobile-unit.service.ts
frontend/src/services/moderator.service.ts
frontend/src/services/notification.service.ts
frontend/app/certificates/page.tsx
frontend/app/dashboard/saved/page.tsx
frontend/app/marketplace/books/page.tsx
frontend/app/notifications/page.tsx
frontend/app/storage/page.tsx
frontend/app/moderator/page.tsx
frontend/app/mobile-unit/page.tsx
frontend/app/career/quiz/page.tsx
frontend/app/map/data-hunter/DataHunterMap.tsx
frontend/app/map/gap-predictor/GapPredictorMap.tsx
frontend/app/map/geo-vision/GeoVisionMap.tsx
frontend/app/map/resource-optimizer/ResourceMap.tsx
frontend/app/map/survey-planner/SurveyPlannerMap.tsx
frontend/components/climate-guardian/ClimateGuardianMap.tsx
frontend/next.config.mjs
frontend/test-app/
frontend/test-results/
# Stale ChromaDB data from earlier uploads — *.bin files were excluded by
# upload_folder ignore_patterns but older .bin files linger on HF Space.
# A fresh chromadb (cache invalidated) can't read stale data → init hangs.
# Let the AI service create a new chroma_db at runtime instead.
ai-service/chroma_db/

# Stale root artifacts
package-lock.json

# OS
.DS_Store
Thumbs.db

# Env files — never needed in Docker image (HF Spaces injects secrets via env vars,
# not .env files). Excluding prevents Next.js build from scanning .env.local etc.
.env
.env.local
.env.production
.env.development

# Edge AI Tutor — model weights are downloaded at runtime, never bundled
ai-service/offline-models/
ai-service/models/*.bin
ai-service/models/*.safetensors
ai-service/models/*.gguf
.env.test
.env*
