# ---------------------------------------------------------------------------
# RENDER — `edumap-ai` (FastAPI, cổng 8000)
#
# Render Dashboard → service edumap-ai → tab Environment → thêm từng dòng.
# Plan free 512 MB: giữ AUTO_SCHEDULER_ENABLED=false (scheduler load 5 vùng
# VN + LLM cùng lúc sẽ OOM). Nâng RAM rồi hãy bật "true".
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
PORT=8000
CHROMA_DB_PATH=/tmp/chroma_db
AUTO_SCHEDULER_ENABLED=false
RAM_THRESHOLD_GB=1.5

# --- Database: Supabase (giống hệt edumap-api) -----------------------------
DB_TYPE=postgres
DB_SYNC=false
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_DATABASE=postgres

# --- Chuỗi provider text: DeepSeek → Gemini → Cloudflare → template --------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat,deepseek-reasoner
DEEPSEEK_TIMEOUT_SECONDS=20

# Gemini: fallback #1 (text) + **nhà cung cấp embedding duy nhất** (RAG).
# Không còn fallback embedding nào khác.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=20

# Cloudflare Workers AI: fallback cuối của **text generation**.
# Embedding sử dụng Gemini API duy nhất, CF không còn gọi chùm embedding.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8,@cf/google/gemma-7b-it-lora,@cf/mistralai/mistral-small-3.1-24b-instruct

# --- Ngân sách thời gian (giữ dưới timeout 45s của Rust) ------------------
EMBED_GLOBAL_TIMEOUT_SECONDS=6
EMBED_PROVIDER_TIMEOUT_SECONDS=4
RAG_TIMEOUT_SECONDS=8
GEN_TIMEOUT_SECONDS=8
STREAM_PROXY_DEADLINE_SECONDS=10
STREAM_FINAL_RESERVE_SECONDS=1.5

# --- Tính năng AI (tuỳ chọn) ----------------------------------------------
# Career trends: Adzuna (không cần LLM). Đặt cùng key với Vercel.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=vn
# Crawler/search.
TAVILY_API_KEY=
# Climate Learning Guardian (thời tiết thật; thiếu → bản đồ ngập tĩnh).
OWM_API_KEY=
# Language Bridge TTS (thiếu → edge-tts → gTTS → browser Web Speech API).
GOOGLE_TTS_API_KEY=
# GeoVision tile nguồn Bing (tuỳ chọn, mặc định OSM).
BING_MAPS_API_KEY=
# Edge AI Tutor: false = trả template ngay, không gọi mạng.
OFFLINE_TUTOR_USE_LLM=true

# --- Crawler / Redis (để trống nghĩa là dùng Postgres trực tiếp) -----------
# REDIS_HOST=
# REDIS_PORT=6379
