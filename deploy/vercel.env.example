# ---------------------------------------------------------------------------
# VERCEL — frontend Next.js + BFF (app/api/**)
#
# Dán từng dòng vào: Vercel → Project → Settings → Environment Variables
# (chọn cả Production + Preview). Sau khi thêm/sửa BẤT KỲ biến nào:
#   Deployments → … → Redeploy   (env được nhúng lúc BUILD, sửa mà không
#   redeploy là không có tác dụng).
#
# KHÔNG đặt ở đây: DB_* , DEEPSEEK_API_KEY , GEMINI_API_KEY , TAVILY_API_KEY ,
# CLOUDFLARE_* , OWM_API_KEY , GOOGLE_TTS_API_KEY , HF_TOKEN , ORS_API_KEY ,
# GOOGLE_CLIENT_SECRET/PROJECT_ID/AUTH_URI/TOKEN_URI/AUTH_PROVIDER_CERT_URL.
# Không file nào trong `frontend/` đọc chúng — chúng thuộc Render (xem
# deploy/render-api.env.example và render-ai.env.example).
# ---------------------------------------------------------------------------

# --- BẮT BUỘC ---------------------------------------------------------------
# Rust backend trên Render. next.config.js rewrites + src/lib/api-config.ts.
BACKEND_URL=https://edumap-api.onrender.com

# FastAPI ai-service trên Render (chat proxy, learning-path, …).
AI_SERVICE_URL=https://edumap-ai.onrender.com

# PHẢI TRÙNG Y HỆT JWT_SECRET của edumap-api (src/lib/auth-utils.ts verify
# chữ ký JWT ở BFF). Lệch → mọi route gọi requireAuth() trả 401.
JWT_SECRET=

# --- Đăng nhập dev (tuỳ chọn) ----------------------------------------------
# app/api/auth/dev-login/route.ts trả 404 ở production nếu khác "true".
ENABLE_DEV_LOGIN=true

# --- Demo/mock data (tuỳ chọn) -------------------------------------------
# `src/mock/install.ts`: unset hoặc `true` = dùng mock data (dev).
# production set `false`.
NEXT_PUBLIC_USE_MOCK_API=false

# --- Google Identity Services (tuỳ chọn) ------------------------------------
# Chỉ cần client id (GIS trả `credential`); KHÔNG cần client secret.
# GOOGLE_CLIENT_ID được đọc runtime bởi app/api/config/route.ts.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Dữ liệu việc làm / sự kiện (tuỳ chọn) ---------------------------------
# app/api/career/jobs/route.ts (fallback khi backend không trả jobs).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# app/api/events/route.ts
TICKETMASTER_API_KEY=

# --- Monitoring (tuỳ chọn) --------------------------------------------------
# Có DSN → next.config.js bật withSentryConfig.
NEXT_PUBLIC_SENTRY_DSN=

# --- Thông báo (tuỳ chọn) -------------------------------------------------
# `true` → Toaster hiện toast ở `app/layout.tsx`. Mặc định tắt.
NEXT_PUBLIC_TOASTS_ENABLED=false

# --- AI service BFF (tuỳ chọn) --------------------------------------------
# URL tương đối mặc định `/api/ai` cho `search.service.ts`. Chỉ dùng
# khi BFF không còn route `/api/ai/...`.
NEXT_PUBLIC_AI_API_URL=/api/ai

# --- Bản đồ (tuỳ chọn, nhưng PHẢI SET) ------------------------------------
# CARTO API key lấy tại https://carto.com/basemaps/apikey/ (free tier
# 5 triệu tile requests / tháng). Đã set → App dùng `dark_nolabels`
# (không có label nào → sidebar tranh chấp tên Quần đảo không bao giờ
# xuất hiện tiếng Trung/Trung Quốc). Chưa set → quay lại
# OpenStreetMap (label có thể vẽ tiếng Trung ở Hoàng Sa/Trường Sa).
# Env này là NEXT_PUBLIC_ → gửi vào bundle của client; không dùng cho
# backend.
NEXT_PUBLIC_CARTO_API_KEY=

# --- Fallback backend (tuỳ chọn) ------------------------------------------
# `src/lib/api-config.ts::getBackendUrl()`: dùng var này thay BACKEND_URL
# khi BACKEND_URL không bằng http(s). NEXT_PUBLIC_ → bundle client.
NEXT_PUBLIC_API_URL=/api
