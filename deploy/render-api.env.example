# ---------------------------------------------------------------------------
# RENDER — `edumap-api` (Rust/axum, cổng 3000)
#
# Render Dashboard → service edumap-api → tab Environment → thêm từng dòng.
# Hoặc khai báo trong render.yaml (repo root) để Blueprint tự tạo.
#
# Biến đọc bởi backend/src/config.rs: BACKEND_PORT, DATABASE_URL hoặc DB_*,
# JWT_SECRET, AI_SERVICE_URL, AI_SERVICE_TIMEOUT, SMTP_HOST, SMTP_PORT.
# Ngoài ra: ROUTING_SERVICE_URL, ENABLE_DEV_LOGIN, DEV_USER_EMAIL,
# STORAGE_DIR, NOTIFICATIONS_URL, VNP_*, BING_MAPS_API_KEY.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# Rust đọc BACKEND_PORT (KHÔNG phải PORT/NODE_ENV như NestJS cũ).
BACKEND_PORT=3000

# PHẢI trùng y hệt JWT_SECRET đặt trên Vercel. Không dùng generateValue của
# render.yaml (nó sinh secret ngẫu nhiên → FE không verify được token).
JWT_SECRET=
JWT_EXPIRES_IN=7d

ENABLE_DEV_LOGIN=true
DEV_USER_EMAIL=dev@edumap.vn

# --- Database: Supabase (LUÔN dùng host pooler, direct host là IPv6 → timeout)
DB_TYPE=postgres
DB_SYNC=false
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_DATABASE=postgres
# Nếu có nguyên URI thì dùng DATABASE_URL (ưu tiên hơn DB_*):
# DATABASE_URL=postgres://postgres.<ref>:<pass>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Service-to-service ----------------------------------------------------
# Mạng nội bộ Render (tên service), KHÔNG phải URL công khai.
AI_SERVICE_URL=http://edumap-ai:8000
AI_SERVICE_TIMEOUT=45

# OSRM public demo (thay OSRM_URL của NestJS cũ).
ROUTING_SERVICE_URL=https://router.project-osrm.org

# --- Tuỳ chọn --------------------------------------------------------------
# NOTIFICATIONS_URL=
# STORAGE_DIR=/tmp/uploads
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# BING_MAPS_API_KEY=
# VNPay (sandbox)
# VNP_TMN_CODE=
# VNP_HASH_SECRET=
# VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNP_RETURN_URL=https://<app>.vercel.app/donations/callback
