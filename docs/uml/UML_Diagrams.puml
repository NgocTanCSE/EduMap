title Sequence: User Authentication & JWT Login Flow (Client -> Gateway -> Auth Module -> TypeORM)

actor "User" as USER #E2E8F0
participant "Web / Mobile Client\n(Browser / App)" as CLIENT #E0E7FF
participant "Nginx Reverse Proxy\n(API Ingress / Gateway)" as NGINX #FEF3C7

box "Backend Core Platform (NestJS)" #F1F5F9
    participant "Auth Controller\n(auth.controller.ts)" as CTRL #DBEAFE
    participant "Auth Service\n(auth.service.ts)" as SVC #DBEAFE
    participant "JWT Service\n(@nestjs/jwt)" as JWT #DBEAFE
    database "PostgreSQL 16\n(users table)" as PG #E2E8F0
end box

database "Redis Cache\n(Rate Limiter / Throttler)" as REDIS #FEE2E2

autonumber "<b>[00]</b>"

USER -> CLIENT : Enter email & password\nClick "Sign In"
activate CLIENT

CLIENT -> NGINX : HTTPS POST /api/v1/auth/login\n{email, password}
activate NGINX

NGINX -> CTRL : Forward HTTP POST /auth/login\n(X-Forwarded-For, X-Real-IP)
activate CTRL

group Brute-Force & Rate Limit Guard [Throttler via Redis]
    CTRL -> REDIS : INCR throttler:login:<IP_or_Email>
    activate REDIS
    REDIS --> CTRL : current_attempts (TTL: 60s)
    deactivate REDIS
    alt #FEE2E2 Attempts > Threshold (e.g. 5 attempts/min)
        CTRL --> CLIENT : 429 Too Many Requests (Rate limit exceeded)
    end
end

CTRL -> SVC : login(email, password)
activate SVC

SVC -> PG : findOne({ where: { email },\n  select: [id, email, password_hash, full_name, role_id] })
activate PG
PG --> SVC : User entity (or null)
deactivate PG

alt #FEE2E2 Case 1: User Not Found
    SVC --> CTRL : throw UnauthorizedException('Thông tin đăng nhập không chính xác')
    CTRL --> CLIENT : HTTP 401 Unauthorized
else #FFFFFF Case 2: User Exists
    SVC -> SVC : bcrypt.compare(password, user.password_hash)
    
    alt #FEE2E2 Password Mismatch (Invalid Credentials)
        SVC --> CTRL : throw UnauthorizedException('Thông tin đăng nhập không chính xác')
        CTRL --> CLIENT : HTTP 401 Unauthorized
    else #D1FAE5 Password Valid (Authentication Successful)
        SVC -> SVC : Build JWT payload:\n{ sub: user.id, email: user.email, role: user.role }
        
        SVC -> JWT : sign(payload, { expiresIn: '1d' })
        activate JWT
        JWT --> SVC : access_token (Signed JWT)
        deactivate JWT
        
        SVC --> CTRL : Return {\n  userId: user.id,\n  email: user.email,\n  full_name: user.full_name,\n  role: user.role,\n  access_token: token\n}
        deactivate SVC
        
        CTRL --> NGINX : HTTP 200 OK\n{ success: true, data: { access_token, user } }
        deactivate CTRL
        
        NGINX --> CLIENT : HTTPS 200 OK Response
        deactivate NGINX
        
        CLIENT -> CLIENT : Store access_token in Secure Storage\n(HttpOnly Cookie or LocalStorage)
        CLIENT --> USER : Redirect to Dashboard (Role-based Navigation)
        deactivate CLIENT
    end
end

@enduml

