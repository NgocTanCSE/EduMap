REGEX_GUARD --> MOD_ROUTER : match_results (flags[])
deactivate REGEX_GUARD

alt #FEE2E2 Layer 1 Match (Severe Profanity or Leaked PII Detected)
    MOD_ROUTER --> AI_SVC : HTTP 200 {\n  status: 'Processed via Regex',\n  is_safe: false, confidence: 1.0,\n  flags: ['Profanity' | 'PII_Phone'],\n  action_taken: 'AUTO_REJECTED'\n}
else #FFFFFF Layer 1 Clean -> Escalate to Layer 2
    == Layer 2: Deep Contextual & Semantic Analysis with Gemini ==
    MOD_ROUTER -> LLM_SVC : moderate_text(content)
    activate LLM_SVC
    
    LLM_SVC -> GEMINI : generate_content(model="gemini-1.5-flash",\n  prompt: "Evaluate text for harassment, hate speech, spam: {content}")
    activate GEMINI
    GEMINI --> LLM_SVC : JSON {is_safe: bool, confidence: float, flags: []}
    deactivate GEMINI
    
    LLM_SVC --> MOD_ROUTER : {is_safe, confidence, flags}
    deactivate LLM_SVC
    
    MOD_ROUTER -> MOD_ROUTER : Evaluate action_taken:\n- If !is_safe && confidence > 0.8 -> 'AUTO_REJECTED'\n- If !is_safe && confidence <= 0.8 -> 'SEND_TO_HUMAN_REVIEW'\n- If is_safe -> 'APPROVED'
    
    MOD_ROUTER --> AI_SVC : HTTP 200 {status, is_safe, confidence, flags, action_taken}
end
deactivate MOD_ROUTER

AI_SVC --> COMM_SVC : moderationResult (action_taken, flags)
deactivate AI_SVC

== Community Service Decision & Persistence Matrix ==

alt #FEE2E2 Case 1: AUTO_REJECTED (Direct Policy Violation)
    COMM_SVC --> COMM_CTRL : throw BadRequestException(\n  "Nội dung vi phạm tiêu chuẩn cộng đồng: " + flags.join(', '))
    COMM_CTRL --> CLIENT : HTTP 400 Bad Request\n{statusCode: 400, message: "Nội dung vi phạm..."}
    CLIENT --> USER : Display error banner & highlight prohibited terms

else #FEF3C7 Case 2: SEND_TO_HUMAN_REVIEW (Ambiguous / Borderline Toxicity)
    COMM_SVC -> PG : INSERT INTO posts (\n  title, content, author_id, group_id,\n  status='pending_review'\n)
    activate PG
    PG --> COMM_SVC : savedPost (id, status='pending_review')
    deactivate PG
    
    COMM_SVC -> NOTIF : notifyModerators(savedPost.id, "Review needed: Flagged borderline content")
    
    COMM_SVC --> COMM_CTRL : {\n  post: savedPost,\n  moderation_message: 'Bài viết đang chờ quản trị viên duyệt'\n}
    COMM_CTRL --> CLIENT : HTTP 201 Created\n{post, moderation_message}
    CLIENT --> USER : Show post in feed with "Under Review" pending badge

else #D1FAE5 Case 3: APPROVED (Content Safe)
    COMM_SVC -> PG : INSERT INTO posts (\n  title, content, author_id, group_id,\n  status='active', like_count=0, comment_count=0\n)
    activate PG
    PG --> COMM_SVC : savedPost (id, status='active')
    deactivate PG
    
    COMM_SVC --> COMM_CTRL : {post: savedPost, moderation_message: null}
    COMM_CTRL --> CLIENT : HTTP 201 Created {post}
    deactivate COMM_CTRL
    CLIENT --> USER : Instantly display active post on community feed
    deactivate CLIENT
end
deactivate COMM_SVC

@enduml

