        usecase "UC16: Tham gia Thử thách xanh & Tình nguyện" as UC_GREEN
        usecase "Kiểm duyệt nội dung 2 lớp (Regex + AI)" as UC_MOD #FFE4E6
        
        UC_POST .> UC_MOD : <<include>>
    }

    package "Phân hệ 6: Quản trị & Điều hành Nền tảng" as PKG_ADMIN #F8FAFC {
        usecase "UC17: Quản trị tài khoản & Phân quyền RBAC" as UC_USER_MGMT
        usecase "UC18: Kiểm duyệt bài viết (Human-in-the-loop)" as UC_MODERATE
        usecase "UC19: Xem bảng điều khiển thống kê (Dashboard)" as UC_STATS
    }

    usecase "Thanh toán Trực tuyến (Ký quỹ/Order)" as UC_PAY #FEF3C7
    UC_BOOK .> UC_PAY : <<include>>
    UC_BUY .> UC_PAY : <<include>>

    ' Grid layout: Col 1, Col 2, Col 3
    PKG_GIS -[hidden]down-> PKG_AI
    PKG_MENTOR -[hidden]down-> PKG_LIB
    PKG_COMM -[hidden]down-> PKG_ADMIN
    
