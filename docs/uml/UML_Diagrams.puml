' ==============================================================================
' 14. STATE MACHINE DIAGRAM: E-COMMERCE & SERVICE ORDER LIFECYCLE
' ==============================================================================
@startuml UML_state-order-lifecycle
skinparam defaultFontName "DejaVu Sans"
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 12
skinparam ArrowColor #334155
skinparam ArrowThickness 1.5
skinparam NoteBackgroundColor #FEF3C7
skinparam NoteBorderColor #D97706
skinparam NoteFontColor #92400E

skinparam state {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  BorderThickness 1.5
  FontColor #0F172A
  FontSize 13
  FontStyle bold
  
  BackgroundColor<<Initial>> #E2E8F0
  BackgroundColor<<Draft>> #F1F5F9
  BackgroundColor<<Pending>> #FEF3C7
  BorderColor<<Pending>> #D97706
  BackgroundColor<<Paid>> #E0F2FE
  BorderColor<<Paid>> #0284C7
  BackgroundColor<<Shipping>> #EDE9FE
  BorderColor<<Shipping>> #7C3AED
  BackgroundColor<<Completed>> #DCFCE7
  BorderColor<<Completed>> #16A34A
  BackgroundColor<<Cancelled>> #FEE2E2
  BorderColor<<Cancelled>> #DC2626
  BackgroundColor<<Composite>> #FFFFFF
  BorderColor<<Composite>> #475569
}

title <size:18><b>EDUMAP PLATFORM - E-COMMERCE & SERVICE ORDER LIFECYCLE</b></size>\n<size:12>Enterprise State Machine Diagram (TypeORM OrderStatus & Transaction Lifecycle)</size>

[*] --> CART_SELECTION : User adds items to Cart

state "<b>SHOPPING_CART</b>\n(Session / CartItem Entity)" as CART_SELECTION <<Draft>> {
  CART_SELECTION : <b>entry /</b> Load active cart items
  CART_SELECTION : <b>do /</b> Validate stock & calculate subtotal
  CART_SELECTION : <b>exit /</b> Lock selected items for checkout
}

CART_SELECTION --> PENDING : <b>POST /api/business/checkout</b>\n[Stock >= quantity]\n/ Deduct stock, create Order & Transaction (UUID)

state "<b>ORDER_PENDING</b>\n(OrderStatus.PENDING)" as PENDING <<Pending>> {
  PENDING : <b>entry /</b> Order created (UUID); Transaction created (PENDING)
  PENDING : <b>entry /</b> Set 15-minute payment expiration timer (Redis TTL)
  PENDING : <b>do /</b> Awaiting payment via COD or Payment Gateway (VNPay/MoMo)
  
  state "Payment Method Branch" as PAY_BRANCH <<Composite>> {
    state "<b>ONLINE_PAYMENT_PENDING</b>\n(VNPay / MoMo Gateway)" as ONLINE_PAY
    state "<b>COD_PENDING</b>\n(Cash on Delivery)" as COD_PAY
    
    ONLINE_PAY : Redirect student to gateway URL
    COD_PAY : Buyer verified phone & address
  }
}

PENDING --> CANCELLED : <b>Payment Timeout (15m elapsed)</b>\n[Transaction not completed]\n/ Restore product stock, mark Transaction FAILED

PENDING --> CANCELLED : <b>Buyer Cancels Checkout</b>\n/ Restore product stock, mark Transaction FAILED

PENDING --> PAID : <b>Webhook IPN: Payment Verified</b>\n(VNPay/MoMo responseCode == '00')\n/ Transaction marked SUCCESS, audit logged

PENDING --> SHIPPING : <b>Vendor Confirms COD Order</b>\n[PaymentMethod == COD]\n/ Lock delivery dispatch, notify shipping carrier

state "<b>ORDER_PAID</b>\n(OrderStatus.PAID)" as PAID <<Paid>> {
  PAID : <b>entry /</b> TransactionStatus = SUCCESS; Escrow funds held
  PAID : <b>entry /</b> Send push notification & email receipt
  PAID : <b>do /</b> Vendor prepares physical goods or provisions digital service
  
  state "Fulfillment Type" as FULFILL_BRANCH <<Composite>> {
    state "<b>PHYSICAL_PACKING</b>\nWarehouse packaging & print shipping label" as PACKING
    state "<b>DIGITAL_SERVICE_PROVISION</b>\nCourse access / Subscription entitlement" as DIGITAL_PROV
  }
}

PAID --> SHIPPING : <b>Vendor Dispatches Order</b>\n/ Generate Tracking Code, assign 3PL Carrier (GHN/GHTK)

PAID --> COMPLETED : <b>Auto-Activate Digital Service</b>\n[OrderItem.serviceId != null]\n/ Unlock course access, skip physical transit

PAID --> CANCELLED : <b>Merchant Out of Stock / Buyer Cancelled</b>\n[Before dispatch]\n/ Initiate Payment Gateway Refund API, restore stock

state "<b>ORDER_SHIPPING</b>\n(OrderStatus.SHIPPING)" as SHIPPING <<Shipping>> {
  SHIPPING : <b>entry /</b> Carrier picks up parcel; dispatch status active
  SHIPPING : <b>do /</b> Webhook sync with 3PL tracking updates (In-Transit)
  SHIPPING : <b>do /</b> COD collection pending (if PaymentMethod == COD)
}

SHIPPING --> COMPLETED : <b>Delivery Confirmed</b>\n(Buyer signs receipt OR Carrier Webhook 'DELIVERED')\n/ If COD: TransactionStatus = SUCCESS, release vendor payout

SHIPPING --> FAILED_DELIVERY : <b>Delivery Attempt Failed 3 Times</b>\n(Buyer unreachable / Address incorrect)

state "<b>DELIVERY_FAILED</b>\n(Return to Vendor)" as FAILED_DELIVERY <<Cancelled>> {
  FAILED_DELIVERY : <b>entry /</b> Carrier returns physical package to vendor
  FAILED_DELIVERY : <b>do /</b> Inspect returned goods condition
}

FAILED_DELIVERY --> CANCELLED : <b>Vendor Confirms Return Receipt</b>\n/ Restock items; process partial/full refund

state "<b>ORDER_COMPLETED</b>\n(OrderStatus.COMPLETED)" as COMPLETED <<Completed>> {
  COMPLETED : <b>entry /</b> Release escrow balance to Business Vendor Wallet
  COMPLETED : <b>entry /</b> Award student platform reward points
  COMPLETED : <b>do /</b> Enable verified purchase review (1-5 stars)
}

state "<b>ORDER_CANCELLED</b>\n(OrderStatus.CANCELLED)" as CANCELLED <<Cancelled>> {
  CANCELLED : <b>entry /</b> Execute Compensating Saga:
  CANCELLED : - Restore product inventory (+quantity)
  CANCELLED : - If paid: issue automated refund via Payment Gateway
  CANCELLED : - Send cancellation notice to Buyer & Vendor
}

COMPLETED --> [*] : Order Lifecycle Closed
CANCELLED --> [*] : Order Lifecycle Terminated

note right of PENDING
  <b>ACID Transaction & Stock Locking:</b>
  During <b>checkout()</b>, stock is decremented
  inside a PostgreSQL repeatable-read transaction.
  If payment times out or fails, a compensating
  worker restores stock:
  <b>product.stock += item.quantity</b>
end note

note right of COMPLETED
  <b>Review & Escrow Release:</b>
  Once in <b>COMPLETED</b>, the student
  is permitted to call <b>POST /api/business/reviews</b>
  and vendor receives platform payout.
end note

@enduml

' ==============================================================================
' 15. STATE MACHINE DIAGRAM: MENTOR BOOKING & CONSULTATION LIFECYCLE
' ==============================================================================
@startuml UML_state-mentor-booking
skinparam defaultFontName "DejaVu Sans"
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 12
skinparam ArrowColor #334155
skinparam ArrowThickness 1.5
skinparam NoteBackgroundColor #FEF3C7
skinparam NoteBorderColor #D97706
skinparam NoteFontColor #92400E

skinparam state {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  BorderThickness 1.5
  FontColor #0F172A
  FontSize 13
  FontStyle bold
  
  BackgroundColor<<SlotSelect>> #F1F5F9
  BackgroundColor<<Pending>> #FEF3C7
  BorderColor<<Pending>> #D97706
  BackgroundColor<<Confirmed>> #E0F2FE
  BorderColor<<Confirmed>> #0284C7
  BackgroundColor<<InSession>> #EDE9FE
  BorderColor<<InSession>> #7C3AED
  BackgroundColor<<Completed>> #DCFCE7
  BorderColor<<Completed>> #16A34A
  BackgroundColor<<Cancelled>> #FEE2E2
  BorderColor<<Cancelled>> #DC2626
  BackgroundColor<<Composite>> #FFFFFF
  BorderColor<<Composite>> #475569
}

title <size:18><b>EDUMAP PLATFORM - MENTOR BOOKING & CONSULTATION LIFECYCLE</b></size>\n<size:12>Enterprise State Machine Diagram (TypeORM Booking & Escrow Lifecycle)</size>

[*] --> SLOT_SELECTION : Student explores Mentors

state "<b>SLOT_BROWSING_&_MATCHING</b>\n(AI Match / Availability Check)" as SLOT_SELECTION <<SlotSelect>> {
  SLOT_SELECTION : <b>entry /</b> AI match via GET /mentoring/mentors/recommend/:userId
  SLOT_SELECTION : <b>do /</b> View verified mentors & available slots (GET /slots)
  SLOT_SELECTION : <b>exit /</b> Select time slot [slot_start, slot_end]
}

SLOT_SELECTION --> BOOKING_PENDING : <b>POST /api/mentoring/book</b>\n[Slot is not booked && student != mentor]\n/ Create Booking (UUID, status: 'pending', meeting_url generated)

state "<b>BOOKING_PENDING</b>\n(status: 'pending')" as BOOKING_PENDING <<Pending>> {
  BOOKING_PENDING : <b>entry /</b> Send in-app notification to Mentor & Student
  BOOKING_PENDING : <b>entry /</b> Start 15-minute escrow payment timer (Redis TTL)
  BOOKING_PENDING : <b>do /</b> Awaiting Escrow Payment & Mentor Acceptance
  
  state "Payment & Acceptance Phase" as PEND_SUB <<Composite>> {
    state "<b>UNPAID_AWAITING_PAYMENT</b>\n(payment_status: 'unpaid')\nStudent redirected to VNPay / MoMo" as UNPAID
    state "<b>ESCROW_PAID_AWAITING_CONFIRM</b>\n(payment_status: 'paid')\nFunds held safely in Platform Escrow" as ESCROW_PAID
    
    UNPAID --> ESCROW_PAID : <b>Payment Webhook IPN</b>\n(responseCode == '00')\n/ payment_status = 'paid'
  }
}

BOOKING_PENDING --> BOOKING_CONFIRMED : <b>Mentor Accepts Booking</b>\n(PATCH /api/mentoring/bookings/:id/status)\n[payment_status == 'paid' OR hourly_rate == 0]\n/ status = 'confirmed', lock calendar slot

BOOKING_PENDING --> BOOKING_CANCELLED : <b>Payment Timeout (15m elapsed)</b>\n[payment_status == 'unpaid']\n/ status = 'cancelled', release time slot

BOOKING_PENDING --> BOOKING_CANCELLED : <b>Student Aborts Request</b>\n/ status = 'cancelled', release time slot

BOOKING_PENDING --> BOOKING_CANCELLED : <b>Mentor Declines Request</b>\n/ status = 'cancelled'\n[If payment_status == 'paid': Trigger Full Refund Gateway API]

state "<b>BOOKING_CONFIRMED</b>\n(status: 'confirmed')" as BOOKING_CONFIRMED <<Confirmed>> {
  BOOKING_CONFIRMED : <b>entry /</b> Calendar invitation dispatched (.ics / Google Calendar)
  BOOKING_CONFIRMED : <b>entry /</b> Schedule reminder job (BullMQ: T-24h, T-1h, T-10m)
  BOOKING_CONFIRMED : <b>do /</b> Awaiting session start time (slot_start)
  BOOKING_CONFIRMED : <b>exit /</b> Activate Jitsi Meet Video Conference room
}

BOOKING_CONFIRMED --> IN_SESSION : <b>Session Start Time Reached (slot_start)</b>\nBoth Student & Mentor enter Jitsi Meet URL\n/ WebRTC connection established, live video active

BOOKING_CONFIRMED --> BOOKING_CANCELLED : <b>Student / Mentor Cancels (> 24h prior)</b>\n(PATCH /bookings/:id/status)\n/ status = 'cancelled', release slot, process 100% refund

BOOKING_CONFIRMED --> BOOKING_CANCELLED : <b>Late Cancellation (< 24h prior)</b>\n/ Apply platform cancellation policy & partial penalty

state "<b>SESSION_IN_PROGRESS</b>\n(Active WebRTC Consultation)" as IN_SESSION <<InSession>> {
  IN_SESSION : <b>entry /</b> Jitsi Meet room active: https://meet.jit.si/edumap-mentor-{uuid}
  IN_SESSION : <b>do /</b> 1-on-1 audio/video, screenshare, chat, whiteboard
  IN_SESSION : <b>do /</b> Session timer countdown (slot_start -> slot_end)
  IN_SESSION : <b>exit /</b> Terminate meeting room session
}

IN_SESSION --> BOOKING_COMPLETED : <b>Session Concluded (slot_end reached)</b>\n(PATCH /api/mentoring/bookings/:id/status)\n[status -> 'completed']\n/ Finalize session duration log

IN_SESSION --> BOOKING_CANCELLED : <b>Critical Technical Failure / Abandoned</b>\n[Dispute raised within call window]\n/ Hold payout for moderator investigation

state "<b>BOOKING_COMPLETED</b>\n(status: 'completed')" as BOOKING_COMPLETED <<Completed>> {
  BOOKING_COMPLETED : <b>entry /</b> Escrow Release: Transfer (Amount - PlatformFee) to Mentor Wallet
  BOOKING_COMPLETED : <b>entry /</b> Send Review & Rating Prompt to Student (1-5 stars)
  BOOKING_COMPLETED : <b>do /</b> Student submits review -> recalculate mentor.rating_avg
  BOOKING_COMPLETED : <b>exit /</b> Archive session recording/notes to student profile
}

state "<b>BOOKING_CANCELLED</b>\n(status: 'cancelled')" as BOOKING_CANCELLED <<Cancelled>> {
  BOOKING_CANCELLED : <b>entry /</b> Free reserved slot in mentor_availabilities
  BOOKING_CANCELLED : <b>entry /</b> Compensating Refund Saga:
  BOOKING_CANCELLED : - If payment_status == 'paid': API refund via VNPay/MoMo
  BOOKING_CANCELLED : - payment_status = 'refunded'
  BOOKING_CANCELLED : - Notify Student & Mentor with cancellation reason
}

COMPLETED --> [*] : Mentorship Cycle Closed
BOOKING_CANCELLED --> [*] : Booking Terminated

note right of BOOKING_PENDING
  <b>Escrow Protection:</b>
  Student funds are locked in Escrow
  prior to session confirmation.
  If the mentor fails to respond or declines,
  the system triggers an automated 100% refund.
end note

note right of BOOKING_COMPLETED
  <b>Rating Recalculation:</b>
  Upon completion, student reviews update:
  <b>mentor.rating_avg = AVG(reviews)</b>
  boosting high-quality mentors on AI match.
end note

@enduml

