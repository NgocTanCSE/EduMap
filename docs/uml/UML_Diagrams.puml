title AI Service - Component Architecture Diagram (FastAPI)

actor "NestJS Backend API\n(HTTP / Axios Client)" as BACKEND

package "AI Service Microservice (FastAPI on Port 8000)" {

  component "FastAPI Application Core (main.py)\n[CORS, Lifespan Management, Global Error Handlers]" as APP #E8EAED

  ' ==================== THREE DOMAIN PILLARS ====================

  ' COLUMN 1: GENERATIVE AI & RAG
  package "Pillar 1: GenAI & Content Processing" as COL_GEN #FFF7ED {
    package "Chat & Moderation Routers" as R_GEN #FFFBEB {
      component "Chat Router\n(/api/ai/chat)" as R_CHAT
      component "Moderation Router\n(/moderate - 2-tier regex/AI)" as R_MOD
      component "Suggestions Router\n(/suggestions)" as R_SUGG
    }

    component "LLMService\n• Google Gemini 2.5 Flash Client\n• Prompt Builder & Context Injection\n• Offline Mock Resiliency Fallback" as S_LLM #FFFFFF
    
    component "RAG Pipeline\n1. Vector similarity search\n2. Redis cache lookup\n3. Dynamic prompt construction\n4. Gemini generation\n5. Cache storage & response" as S_RAG #FFFFFF

    R_GEN -down-> S_LLM : prompt & chat
    S_LLM -down-> S_RAG : executes
  }

  ' COLUMN 2: ADVISORY & KNOWLEDGE SEARCH
  package "Pillar 2: Advisory & Knowledge Base" as COL_ADV #FEFCE8 {
    package "Advisory & Search Routers" as R_ADV #FFFFF0 {
      component "Career Router (/career)" as R_CAREER
      component "Mentor Router (/mentor)" as R_MENTOR
      component "Scholarship Router (/scholarship)" as R_SCHOLAR
      component "Learning Path Router (/learning_path)" as R_PATH
      component "Library Router (/library - doc summary)" as R_LIB
      component "Search Router (/search - vector search)" as R_SEARCH
    }

    component "VectorStoreService\n• ChromaDB Collection Manager\n• Chunking & Embedding Query" as S_VECTOR #FFFFFF
    
    component "CacheService\n• Redis Async Connection Pool\n• Response Cache & Invalidation" as S_CACHE #FFFFFF

    R_ADV -down-> S_VECTOR : vector search
  }

  ' COLUMN 3: SPATIAL & PREDICTIVE ANALYTICS
  package "Pillar 3: Spatial & Predictive Analytics" as COL_GEO #F5F3FF {
    package "Analytics & Geo Routers" as R_GEO_PKG #FAF5FF {
      component "Geo Router (/geo - spatial clustering)" as R_GEO
      component "Analytics Router (/analytics - KPI stats)" as R_ANALYTICS
      component "Predictive Router (/predictive - forecast)" as R_PREDICT
    }

    component "ClusteringService\n• scikit-learn (DBSCAN & KMeans)\n• Facility Spatial Density & Hotspots" as S_CLUSTER #FFFFFF
    
    component "PredictiveService\n• pandas, numpy, statsmodels\n• Enrollment Trend & Skill Forecasting" as S_PRED #FFFFFF

    component "DBService\n• PostgreSQL Connection Pool (psycopg2)\n• History Logging & Stats DAO" as S_DB #FFFFFF

    R_GEO_PKG -down-> S_CLUSTER : spatial clustering
    R_GEO_PKG -down-> S_PRED : enrollment forecast
    R_GEO_PKG -down-> S_DB : query education stats
  }

  ' Horizontal alignment of the 3 pillars
  COL_GEN -[hidden]right- COL_ADV
  COL_ADV -[hidden]right- COL_GEO
}

' Center APP above the middle pillar
COL_ADV -[hidden]up- APP
BACKEND -down-> APP : HTTP REST / JSON Requests

APP -down-> R_GEN : mounts
APP -down-> R_ADV : mounts
APP -down-> R_GEO_PKG : mounts

' ==================== INFRASTRUCTURE ====================
cloud "Google Gemini API\n(Vertex AI / Studio)\n(LLM Inference)" as CLOUD_GEMINI
database "ChromaDB\n(Vector DB Volume)\n(/app/chroma_db)" as DB_CHROMA
database "Redis 7\n(Cache & Session)\n(Port 6379)" as DB_REDIS
database "PostgreSQL 16\n+ PostGIS 3.4\n(Port 5432)" as DB_POSTGRES

' Infrastructure horizontal alignment
CLOUD_GEMINI -[hidden]right- DB_CHROMA
DB_CHROMA -[hidden]right- DB_REDIS
DB_REDIS -[hidden]right- DB_POSTGRES

' Cross-pillar coordination
R_ADV -left-> S_LLM : career advice, mentor\nmatching, scholarship check
R_GEN -right-> S_DB : save chat history

S_RAG -right-> S_VECTOR : query top-k docs
S_RAG -right-> S_CACHE : get / set response cache

S_CLUSTER -left-> S_CACHE : cache cluster results
S_CLUSTER -down-> S_DB : fetch coordinates
S_PRED -down-> S_DB : fetch historical KPI

' Pillar to Infrastructure (Direct vertical drops)
S_LLM -down-> CLOUD_GEMINI : HTTPS REST API
S_VECTOR -down-> DB_CHROMA : Chroma Client API
S_CACHE -down-> DB_REDIS : Redis TCP (6379)
S_DB -down-> DB_POSTGRES : psycopg2 (SQL)

@enduml

