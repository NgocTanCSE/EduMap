    activate GATEWAY
    GATEWAY --> PAY_SVC : paymentUrl
    deactivate GATEWAY
    
    PAY_SVC --> CLIENT : HTTP 200 OK {paymentUrl, transactionId}
    deactivate PAY_SVC
    
    CLIENT -> GATEWAY : Redirect Student to Payment Gateway
    deactivate CLIENT
    activate GATEWAY
    
    USER -> GATEWAY : Authorize Payment (OTP / QR Pay)
    
    group Asynchronous Server-to-Server IPN Webhook
        GATEWAY -> PAY_SVC : POST /api/payment/ipn-webhook\n(transactionId, responseCode='00', secureHash)
        activate PAY_SVC
        
        PAY_SVC -> PAY_SVC : Verify HMAC Signature & Payment Status
        
        alt #D1FAE5 Payment Verified (Success)
            PAY_SVC -> PG : UPDATE transactions SET status='SUCCESS' WHERE id=transactionId
            PAY_SVC -> PG : UPDATE bookings SET payment_status='paid', status='confirmed'\nWHERE transaction_id=transactionId
            
            PAY_SVC -> NOTIF : notifyStudent & notifyMentor(\n  "Lịch hẹn đã được xác nhận. Link họp: meet.jit.si/edumap-..."\n)
            
            PAY_SVC --> GATEWAY : HTTP 200 OK {RspCode: '00', Message: 'Confirm Success'}
        else #FEE2E2 Payment Failure / Fraudulent
            PAY_SVC -> PG : UPDATE transactions SET status='FAILED'
            PAY_SVC --> GATEWAY : HTTP 200 OK {RspCode: '97', Message: 'Checksum Error'}
        end
        deactivate PAY_SVC
    end
    
    GATEWAY --> CLIENT : Browser Redirect to Booking Success Page
    deactivate GATEWAY
    activate CLIENT
    CLIENT --> USER : Display Confirmed Appointment Details & Jitsi Meeting Link
    deactivate CLIENT
