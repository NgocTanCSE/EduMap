title Sequence: Business Checkout & Two-Phase Payment Processing (ACID Transaction + IPN Webhook)

actor "Customer\n(Student / User)" as USER #E2E8F0
participant "Web / Mobile Client\n(Checkout UI)" as CLIENT #E0E7FF

box "Backend Core Platform (NestJS)" #F1F5F9
    participant "Business Controller\n(business.controller.ts)" as BIZ_CTRL #DBEAFE
    participant "Business Service\n(business.service.ts)" as BIZ_SVC #DBEAFE
    participant "Payment Controller\n(payment.controller.ts)" as PAY_CTRL #DBEAFE
    participant "Payment Service\n(payment.service.ts)" as PAY_SVC #DBEAFE
    database "PostgreSQL 16\n(orders, items, transactions)" as PG #E2E8F0
end box

participant "Payment Gateway\n(VNPay / Momo / Stripe)" as GATEWAY #FEF3C7
database "MinIO Object Store\n(Receipts & Invoices)" as MINIO #DCFCE7

autonumber "<b>[00]</b>"

== Phase 1: ACID Order Creation & Inventory Lock ==

USER -> CLIENT : Review Cart & Click "Place Order"\nSelect Payment Method (Online / COD)
activate CLIENT

CLIENT -> BIZ_CTRL : HTTP POST /api/business/checkout\n(Bearer JWT, {shippingAddress, paymentMethod})
activate BIZ_CTRL

BIZ_CTRL -> BIZ_SVC : checkout(userId, checkoutDto)
activate BIZ_SVC

group ACID Transaction [TypeORM QueryRunner]
    BIZ_SVC -> PG : queryRunner.startTransaction()
    activate PG
    
    BIZ_SVC -> PG : getCart(userId) -> CartItem[]
    PG --> BIZ_SVC : cartItems[] (products, services, quantities)
    
    loop For each CartItem
        BIZ_SVC -> PG : Check stock availability & Lock row\n(product.stock >= item.quantity)
        BIZ_SVC -> PG : UPDATE products SET stock = stock - quantity
    end
    
    BIZ_SVC -> BIZ_SVC : Calculate totalAmount = SUM(price * quantity)
    
    BIZ_SVC -> PG : INSERT INTO orders (userId, totalAmount, shippingAddress, status='PENDING')
    PG --> BIZ_SVC : savedOrder (orderId)
    
    BIZ_SVC -> PG : INSERT INTO order_items (orderId, productId, quantity, priceAtPurchase)
    
    BIZ_SVC -> PG : INSERT INTO transactions (orderId, paymentMethod, amount, status='PENDING')
    PG --> BIZ_SVC : savedTransaction (transactionId)
    
    BIZ_SVC -> PG : DELETE FROM cart_items WHERE userId = userId
    
    BIZ_SVC -> PG : queryRunner.commitTransaction()
    deactivate PG
end

BIZ_SVC --> BIZ_CTRL : Return {orderId, transactionId, totalAmount}
deactivate BIZ_SVC

BIZ_CTRL --> CLIENT : HTTP 201 Created\n{orderId, transactionId, totalAmount}
deactivate BIZ_CTRL

== Phase 2: Payment Gateway Execution & Webhook Resolution ==

alt #EFF6FF Scenario A: Online Payment (VNPay / Momo / Stripe)
    CLIENT -> PAY_CTRL : HTTP POST /api/payment/process/:transactionId\n{paymentMethod, returnUrl}
    activate PAY_CTRL
    PAY_CTRL -> PAY_SVC : processPayment(transactionId, paymentData)
    activate PAY_SVC
    
    PAY_SVC -> GATEWAY : Generate Signed Payment URL / Payment Intent\n(amount, orderInfo, hmacChecksum)
    activate GATEWAY
    GATEWAY --> PAY_SVC : paymentUrl (Hosted Checkout URL)
    deactivate GATEWAY
    
    PAY_SVC --> PAY_CTRL : {paymentUrl, transactionId}
    deactivate PAY_SVC
    PAY_CTRL --> CLIENT : HTTP 200 OK {paymentUrl}
    deactivate PAY_CTRL
    
    CLIENT -> GATEWAY : Redirect User to Payment Gateway URL
    deactivate CLIENT
    activate GATEWAY
    
    USER -> GATEWAY : Enter OTP / Scan QR / Authorize Payment
    GATEWAY -> GATEWAY : Validate Funds & Authenticate Card/Wallet
    
    group Asynchronous Server-to-Server IPN Webhook
        GATEWAY -> PAY_CTRL : POST /api/payment/ipn-webhook\n(transactionId, vnp_ResponseCode, secureHash)
        activate PAY_CTRL
        PAY_CTRL -> PAY_SVC : verifySignature & processPayment(transactionId, payload)
        activate PAY_SVC
        
        alt #D1FAE5 Payment Successful (Signature Valid & Code == '00')
            PAY_SVC -> PG : UPDATE transactions SET status = 'SUCCESS'\nWHERE id = transactionId
            PAY_SVC -> PG : UPDATE orders SET status = 'PAID'\nWHERE id = orderId
            
            group Post-Payment Asynchronous Processing
                PAY_SVC -> MINIO : Upload Digital PDF Receipt (receipt_<orderId>.pdf)
                activate MINIO
                MINIO --> PAY_SVC : receipt_url
                deactivate MINIO
            end
            
            PAY_SVC --> PAY_CTRL : {success: true, message: 'Thanh toán thành công'}
            PAY_CTRL --> GATEWAY : HTTP 200 OK {RspCode: '00', Message: 'Confirm Success'}
            deactivate PAY_CTRL
        else #FEE2E2 Payment Failed / Cancelled
            PAY_SVC -> PG : UPDATE transactions SET status = 'FAILED'
            PAY_SVC -> PG : UPDATE orders SET status = 'CANCELLED'\n(Revert inventory stock)
            PAY_SVC --> PAY_CTRL : throw BadRequestException
            PAY_CTRL --> GATEWAY : HTTP 200 OK {RspCode: '01', Message: 'Payment Failed'}
        end
        deactivate PAY_SVC
    end
    
    GATEWAY --> CLIENT : Browser Redirect to Return URL (/payment/result?orderId=...)
    deactivate GATEWAY
    activate CLIENT
    CLIENT --> USER : Display Order Success Screen & Receipt Download Link
    deactivate CLIENT

else #FFFBEB Scenario B: Cash on Delivery (COD)
    CLIENT --> USER : Order Placed! Display "Pay upon delivery"\nOrder remains PENDING until shipment completion
end

@enduml

