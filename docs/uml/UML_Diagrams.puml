title Deployment Architecture - EduMap Production (Kubernetes Cluster & Cloud Services)

' =============================================================================
' 1. CLIENT ACCESS TIER
' =============================================================================
node "Client Devices Tier" as CLIENT_TIER {
  node "Web Browser Clients\n(Desktop & Tablet)" as NODE_WEB {
    artifact "Next.js 14 Web App\n(Chrome / Edge / Safari / Firefox)" as CLIENT_WEB
  }
  node "Mobile Devices\n(Android & iOS)" as NODE_MOBILE {
    artifact "React Native Mobile App\n(Expo Framework)\nREST & Socket.IO Client" as CLIENT_APP
  }
}

CLIENT_WEB -[hidden]right- CLIENT_APP

' =============================================================================
' 2. KUBERNETES CLUSTER (PRODUCTION ENVIRONMENT)
' =============================================================================
node "Kubernetes Cluster (Production Namespace: edumap-prod)" as K8S_CLUSTER {

  ' Ingress Layer
  node "Ingress & Edge Routing Layer" as INGRESS_LAYER {
    component "Nginx Ingress Controller\n(TLS 1.3 Termination, SSL Let's Encrypt)\nLoadBalancer Service (Port 80 / 443)" as INGRESS
  }

  ' Workloads Layer
  node "Stateless Workloads Layer (Pod Deployments)" as WORKLOADS_LAYER {
    node "Frontend Deployment\n(HPA: 2-5 Replicas)" as POD_FE {
      component "Next.js 14 SSR/SSG\nNode.js 20 Alpine\nClusterIP: 3000" as APP_FE
    }

    node "Backend Core Deployment\n(HPA: 3-10 Replicas, CPU > 70%)" as POD_BE {
      component "NestJS 10 Enterprise API\nNode.js 18 Alpine\nClusterIP: 3001\nREST API & Socket.IO Gateway" as APP_BE
    }

    node "AI Service Deployment\n(HPA: 2-4 Replicas)" as POD_AI {
      component "FastAPI Microservice\nPython 3.11 Slim\nClusterIP: 8000\nRAG Engine & ML Pipelines" as APP_AI
    }
  }

  APP_FE -[hidden]right- APP_BE
  APP_BE -[hidden]right- APP_AI

  ' Data Storage Layer
  node "Stateful & Persistence Layer (StatefulSets & PersistentVolumes)" as STORAGE_LAYER {
    database "MinIO S3 Storage\nDistributed StatefulSet\nPersistentVolume: 500GB\nBuckets: media, books, avatars\n(Port 9000 / Console 9001)" as DB_MINIO

    database "PostgreSQL 16 + PostGIS 3.4\nPrimary-Replica StatefulSet\nHigh-IOPS NVMe SSD PVC\nExtensions: postgis, pg_trgm\n(Port 5432)" as DB_PG

    database "Redis 7 Alpine\nIn-Memory StatefulSet\n- Cache Store (TTL)\n- BullMQ Queues (No RabbitMQ)\n- Socket.IO Adapter Pub/Sub\n(Port 6379)" as DB_REDIS

    database "ChromaDB Vector Store\nLocal PersistentVolume PVC\nEmbedding Index Vectors\n(Mounted at /app/chroma_db)" as DB_CHROMA
  }

  DB_MINIO -[hidden]right- DB_PG
  DB_PG -[hidden]right- DB_REDIS
  DB_REDIS -[hidden]right- DB_CHROMA
}

' =============================================================================
' 3. EXTERNAL CLOUD & THIRD-PARTY SERVICES
' =============================================================================
node "External Cloud Platforms & Third-Party APIs" as EXT_SERVICES {
  cloud "Notification & Communications" as CLOUD_MAIL {
    component "SMTP / Cloud Mailer Service\nEmail Verification & Alerts\n(TLS Port 587)" as API_MAIL
  }

  cloud "Payment Gateway Providers\n(PCI-DSS Compliant)" as CLOUD_PAY {
    component "VNPay / MoMo / Stripe\nPayment Gateways & IPN Webhooks\n(HTTPS Port 443)" as API_PAY
  }

  cloud "Google Cloud Platform" as CLOUD_GCP {
    component "Google Gemini 1.5 Flash / Pro\nMultimodal LLM API\n(google-generativeai SDK)" as API_GEMINI
    component "Google Cloud Monitoring\nAPM, Logs & System Telemetry" as API_MON
  }

  cloud "Hugging Face Spaces" as CLOUD_HF {
    component "EduMap Demo / Staging\nUnified Docker Container\n(Reverse Proxy Port 7860)" as API_HF
  }
}

CLOUD_MAIL -[hidden]right- CLOUD_PAY
CLOUD_PAY -[hidden]right- CLOUD_GCP
CLOUD_GCP -[hidden]right- CLOUD_HF

' Anchor vertical hierarchy
