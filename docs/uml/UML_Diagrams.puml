}

partition "<b>Stage 2: Master Aggregation & Cleansing (aggregator.py & quality_check.py)</b>" #F1F5F9 {
  :<b>Receive Multi-Source Stream</b> (DataAggregator)\nTag sources: ['osm', 'native_wifi', 'native_school', 'native_book', ...];
  
  :<b>Cleanse & Normalize Data</b>\n- Preserve Vietnamese UTF-8 diacritics\n- Standardize category taxonomy & address formats;
  
  :<b>Spatial Bounding Box Validation</b> (quality_check.py)\nVerify coordinates within Đồng Nai / Vietnam BBox:\n[10.6°N - 11.6°N, 106.7°E - 107.6°E];
  
  if (Coordinates valid & within BBox?) then (yes)
    :<b>Deduplication Engine</b> (_dedup_locations)\n- Match normalized name + rounded lat/lng (4 decimals)\n- Eliminate duplicates within ~11m radius;
  else (no)
    :<b>Quarantine Corrupt Coordinates</b>\nLog anomaly to error report & discard record;
    detach
  endif
}

fork
