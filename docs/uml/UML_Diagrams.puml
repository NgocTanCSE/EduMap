title Container Diagram - EduMap System (C4 Model Level 2)

' =============================================================================
' 1. CLIENT LAYER
' =============================================================================
package "Client Layer" as CLIENT_LAYER #FAFAFA {
  component "Web Browser\n[Next.js 14 SPA & SSR Client]" as WEB #FEFCE8
  component "Mobile App\n[Expo / React Native Workflow]" as MOBILE #FEFCE8
  WEB -right- MOBILE
}

' =============================================================================
' 2. INGRESS & EDGE PROXY
' =============================================================================
package "Edge & Ingress Layer" as EDGE_LAYER #F1F5F9 {
  component "Nginx Reverse Proxy / K8s Ingress\n(Port 80 / 443 — TLS Termination, Path Routing & Rate Limit)" as NGINX #EFF6FF
}

' =============================================================================
' 3. APPLICATION CONTAINERS (EDUMAP PLATFORM CORE)
' =============================================================================
package "EduMap Core Application Containers" as APP_LAYER #FFFFFF {
  
  component "Frontend Web Application\n[Next.js 14 App Router, TypeScript, Tailwind CSS]\n• Server-Side Rendering (SSR) & ISR\n• Interactive Map UI & Student Dashboards\n(Internal Port: 3000)" as FRONTEND #F0FDF4

  component "Backend API Gateway & Business Core\n[NestJS, TypeScript, Node.js 18+]\n• REST API Controller (35+ Modules)\n• WebSocket Gateway (Socket.IO Realtime)\n• JWT Authentication & RBAC Policy Engine\n(Internal Port: 3001)" as BACKEND #EFF6FF

  component "AI Intelligence Microservice\n[FastAPI, Python 3.11]\n• Gemini RAG Engine & Dynamic Prompts\n• Machine Learning (scikit-learn & pandas)\n• 2-Tier Content Safety Moderation\n(Internal Port: 8000)" as AI #FFF7ED

  FRONTEND -right- BACKEND
  BACKEND -right- AI
}

' =============================================================================
' 4. DATA & PERSISTENCE LAYER
' =============================================================================
package "Data & Storage Persistence Layer" as DATA_LAYER #F8FAFC {
  database "PostgreSQL 16 + PostGIS 3.4\n(Relational & Spatial Database)\n• 48 Entities, PostGIS geography(Point, 4326)\n• Spatial Indexes & Full-text Search (pg_trgm)\n(Port: 5432)" as POSTGRES

  database "Redis 7\n(In-Memory Cache & Message Broker)\n• Distributed Cache Manager\n• Socket.IO Redis Adapter Pub/Sub\n• BullMQ Asynchronous Task Queue\n(Port: 6379)" as REDIS

  database "MinIO S3\n(Object Storage Service)\n• Buckets: learning-materials, avatars,\n  post-photos, certificate-pdfs, receipts\n(Port: 9000 / Console 9001)" as MINIO

  database "ChromaDB\n(Vector Database)\n• Persistent Vector Collections (/app/chroma_db)\n• Document Chunks & Knowledge Embeddings" as CHROMA

  POSTGRES -right- REDIS
  REDIS -right- MINIO
  MINIO -right- CHROMA
}

' =============================================================================
' 5. EXTERNAL 3RD-PARTY CLOUD SERVICES
' =============================================================================
package "External Services & Cloud Ecosystem" as EXT_LAYER #FAFAFA {
  cloud "Google Gemini API\n(Vertex AI / Google AI Studio)\n• Multimodal LLM Inference\n(gemini-2.5-flash / 1.5-flash)" as GEMINI

  cloud "Payment Gateways\n• VNPay, MoMo, Stripe API\n(Checkout & IPN Webhook)" as PAYMENTS #F0FDF4

  cloud "SMTP Mailer Service\n• Transactional Emails\n(Gmail / SendGrid SMTP)" as SMTP
}

' =============================================================================
' TRAFFIC & INTERACTION FLOWS
' =============================================================================
CLIENT_LAYER -[hidden]down-> EDGE_LAYER
EDGE_LAYER -[hidden]down-> APP_LAYER
APP_LAYER -[hidden]down-> DATA_LAYER
DATA_LAYER -[hidden]down-> EXT_LAYER

' Client to Ingress
WEB -down-> NGINX : HTTPS 443\n(Web traffic)
MOBILE -down-> NGINX : HTTPS 443\n(API & Media)

' Ingress to Containers
NGINX -down-> FRONTEND : HTTP 3000\n(/ - Web Pages)
NGINX -down-> BACKEND : HTTP 3001\n(/api/*, /api/socket.io)
NGINX -down-> MINIO : HTTP 9000\n(/media/* static assets)

' Application inter-service communications
FRONTEND -down-> BACKEND : REST API / WebSocket\n(/api/* - client requests)
BACKEND -down-> AI : HTTP REST (Axios)\n(Internal microservice RPC)

' Backend to Data Stores
BACKEND -down-> POSTGRES : TypeORM Pool\n(CRUD & Spatial Queries)
BACKEND -down-> REDIS : Cache Manager,\nSocket.IO, BullMQ
BACKEND -down-> MINIO : AWS S3 SDK\n(Upload & Download)

' AI Service to Data Stores
AI -down-> POSTGRES : psycopg2\n(Read stats, save chat history)
AI -down-> REDIS : async redis client\n(Cache get / set)
AI -down-> CHROMA : ChromaDB Native Client\n(Vector similarity search)

' External Cloud Connections
AI -down-> GEMINI : HTTPS REST\n(Prompt completion)
BACKEND -down-> PAYMENTS : HTTPS REST / IPN\n(Process transactions)
BACKEND -down-> SMTP : SMTP 587\n(Send verification & alerts)

@enduml

