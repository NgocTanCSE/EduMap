title Sequence: AI RAG Chatbot Flow (Client -> NestJS Gateway -> FastAPI AI -> Gemini 1.5)

actor "User\n(Student/Public)" as USER #E2E8F0
participant "Web / Mobile Client\n(Next.js / Flutter)" as CLIENT #E0E7FF

box "Backend Core Platform (NestJS)" #F1F5F9
    participant "AI Controller\n(ai.controller.ts)" as CTRL #DBEAFE
    participant "AI Service\n(ai.service.ts)" as SVC #DBEAFE
    database "PostgreSQL 16\n(Materials, Locations, ChatHistory)" as PG #E2E8F0
end box

box "AI Microservice (FastAPI Engine)" #FEF3C7
    participant "Chat Router\n(routers/chat.py)" as AI_ROUTER #FDE68A
    participant "LLM Service\n(services/llm_service.py)" as LLM #FDE68A
    database "Redis Cache\n(Response Cache)" as REDIS #FEE2E2
    database "ChromaDB\n(Vector Store)" as CHROMA #DCFCE7
end box

participant "Google GenAI\n(Gemini 1.5 Flash API)" as GEMINI #F3E8FF

autonumber "<b>[00]</b>"

USER -> CLIENT : Enter prompt / query in Chat UI
activate CLIENT

CLIENT -> CTRL : HTTP POST /api/ai/chat\n(Bearer JWT, message, history[], clientContext)
activate CTRL

CTRL -> CTRL : Validate payload & extract req.user.id
CTRL -> SVC : chat(message, history, clientContext, userId)
activate SVC

group Dynamic Grounding Context Retrieval [NestJS TypeORM]
    SVC -> PG : Query top-5 LearningMaterials + top-10 Locations
    activate PG
    PG --> SVC : materials[], locations[]
    deactivate PG
    SVC -> SVC : Build systemContext (books, campus facilities, metadata)
end

SVC -> AI_ROUTER : HTTP POST ${AI_SERVICE_URL}/chat/\n{user_id, message, history, context: systemContext}
activate AI_ROUTER

AI_ROUTER -> LLM : chat_with_rag(message, history, systemContext)
activate LLM

group 1. Cache Layer Check [Redis]
    LLM -> LLM : Compute cache_key = MD5(message + history + context)
    LLM -> REDIS : GET(cache_key)
    activate REDIS
    REDIS --> LLM : Cached response (Hit / Miss)
    deactivate REDIS
end

alt #D1FAE5 Cache Hit
    LLM --> AI_ROUTER : Return {reply: cached_text, sources: cached_sources}
else #FFFBEB Cache Miss (Full RAG Pipeline)
    group 2. Semantic Search [ChromaDB Vector Store]
        LLM -> CHROMA : query(query_text=message, n_results=3)
        activate CHROMA
        CHROMA --> LLM : Top-3 relevant docs, metadata & snippet IDs
        deactivate CHROMA
    end

    group 3. Prompt Assembly & Anti-Hallucination Guardrails
        LLM -> LLM : Build system_instruction (Core Rules: Zero Hallucination)\n+ RAG context + Dynamic Context + Formatted conversation history
    end

    group 4. Cloud LLM Inference [Google Gemini]
        LLM -> GEMINI : generate_content(model="gemini-1.5-flash", prompt, config)\n(temperature=0.3, top_p=0.8, max_tokens=2048)
        activate GEMINI
        GEMINI --> LLM : response.text (Generated accurate reply)
        deactivate GEMINI
    end

    group 5. Cache Storage
        LLM -> REDIS : SETEX(cache_key, ttl=3600, {reply, sources})
        activate REDIS
        REDIS --> LLM : OK
        deactivate REDIS
    end

    LLM --> AI_ROUTER : Return {reply, sources}
end
deactivate LLM

AI_ROUTER --> SVC : HTTP 200 {reply, sources: [doc_id, title, snippet]}
deactivate AI_ROUTER

group 6. Persistent Audit & Chat History [NestJS TypeORM]
    alt #EFF6FF userId exists
        SVC -> PG : historyRepo.save(ChatHistory {\n  user_id, message, response, context\n})
        activate PG
        PG --> SVC : Persisted Record (id, createdAt)
        deactivate PG
    end
end

SVC --> CTRL : Return response {reply, sources}
deactivate SVC

CTRL --> CLIENT : HTTP 200 OK\n{reply, sources, timestamp}
deactivate CTRL

CLIENT --> USER : Render AI message with interactive source citations
deactivate CLIENT

