{
  "info": {
    "name": "EduMap API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password123\",\n  \"full_name\": \"Test User\",\n  \"role\": \"student\"\n}"
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ]
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/auth/profile",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Updated Name\",\n  \"bio\": \"New bio\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Map",
      "item": [
        {
          "name": "Get All POIs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/map/pois"
          }
        },
        {
          "name": "Get Locations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/map/locations"
          }
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/map/categories"
          }
        },
        {
          "name": "AI Geo Analysis",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/map/ai-analysis",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Biên Hòa\",\n  \"context\": {}\n}"
            }
          }
        }
      ]
    },
    {
      "name": "AI Chat",
      "item": [
        {
          "name": "Chat with AI",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/chat",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Xin chào, tư vấn giúp tôi về lập trình\",\n  \"history\": [],\n  \"context\": {}\n}"
            }
          }
        },
        {
          "name": "Get Chat History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ai/history",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ]
          }
        }
      ]
    },
    {
      "name": "Community",
      "item": [
        {
          "name": "Get Posts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/community/posts?page=1&limit=10"
          }
        },
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/community/posts",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bài viết mới\",\n  \"content\": \"Nội dung bài viết\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Career",
      "item": [
        {
          "name": "Get Career Paths",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/career/paths"
          }
        },
        {
          "name": "Search Jobs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/career/jobs?limit=10"
          }
        },
        {
          "name": "Get User Skills",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/career/user-skills",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ]
          }
        },
        {
          "name": "AI Suggestions",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/career/suggest",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ]
          }
        }
      ]
    },
    {
      "name": "Opportunities",
      "item": [
        {
          "name": "Get All Opportunities",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/opportunities"
          }
        },
        {
          "name": "Get Opportunity by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/opportunities/{{opportunityId}}"
          }
        }
      ]
    },
    {
      "name": "Library",
      "item": [
        {
          "name": "Search Materials",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/library/search?q=học&s=1&limit=10"
          }
        },
        {
          "name": "Get Material Summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/library/resources/{{materialId}}/summary"
          }
        }
      ]
    }
  ]
}