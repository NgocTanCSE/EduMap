# EduMap — Hugging Face Spaces environment template (docker-compose.hf.yml)
#
# On Hugging Face Spaces, prefer setting these as Space Secrets (Settings >
# Secrets) instead of committing real values:
#   GEMINI_API_KEY, DB_PASSWORD, JWT_SECRET
#
# For LOCAL docker-compose preview, copy this file and edit:
#   cp .env.hf.example .env.hf  &&  docker compose -f docker-compose.hf.yml --env-file .env.hf up -d --build

# ── PostgreSQL (used by scripts/hf_entrypoint.sh for role/db creation) ──
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=change-me-in-prod
DB_DATABASE=edumap_db

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379

# ── Auth ──
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── AI Service ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── OSRM routing (optional; backend falls back gracefully if empty) ──
OSRM_URL=

# ── MinIO / media ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Backend web port (inside the supervised container) ──
PORT=3000
