# EduMap — Hugging Face Spaces environment template (docker-compose.hf.yml)
#
# On Hugging Face Spaces, prefer setting these as Space Secrets (Settings >
# Secrets) instead of committing real values:
#   GEMINI_API_KEY, DB_PASSWORD, JWT_SECRET
#
# For LOCAL docker-compose preview, copy this file and edit:
#   cp .env.hf.example .env.hf  &&  docker compose -f docker-compose.hf.yml --env-file .env.hf up -d --build

# ── PostgreSQL (used by scripts/hf_entrypoint.sh for role/db creation) ──
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=change-me-in-prod
DB_DATABASE=edumap_db

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379

# ── Auth ──
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Google OAuth (for frontend Google Identity Services One Tap / Sign-In button) ──
# Get your OAuth 2.0 Client ID from: https://console.cloud.google.com/apis/credentials
# Set as a Space Secret on Hugging Face for production.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# ── AI Service ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── OSRM routing (optional; backend falls back gracefully if empty) ──
OSRM_URL=

# ── MinIO / media ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Nightly POI crawler (chợ + Bách hóa Xanh / convenience stores) ──
# Runs via supervisord [program:crawl-pois-vietnam] at 00:30 each night.
# All of these are optional — sensible Vietnam defaults are built into the script.
CRAWL_OVERPASS_URL=https://overpass-api.de/api/interpreter   # free OSM API (no key)
CRAWL_BBOX=8.0,102.0,23.5,109.5        # south,west,north,east — Vietnam
CRAWL_TILE_DEG=1.5                     # chunk size; smaller = safer against Overpass timeouts
CRAWL_SLEEP=1.2                        # seconds between Overpass requests (~1 req/s)
CRAWL_DEDUP_METERS=50                  # skip POIs that already exist within this radius + same name
CRAWL_DRY_RUN=0                        # 1 = summary only, no DB writes
CRAWL_LOG=/data/crawl_pois.log         # supervisor stdout also goes here
PORT=3000
