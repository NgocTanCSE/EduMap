SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# EduMap crawler crontab (container TZ = Asia/Ho_Chi_Minh, so 0 0 * * * == 00:00 local).

# --- nightly FEATURE crawlers (00:00) — UPSERT only, NEVER DROP SCHEMA / wipe ---
# Populates jobs, internships, hackathons->posts, events, scholarships,
# donations->campaigns, community+social->posts, gamification badges/challenges.
# Each crawler is idempotent and degrades gracefully (blocked source -> 0 rows).
0 0 * * * root bash /app/scripts/run_feature_crawlers.sh >> /app/crawlers/crawled_data/feature_crawl.log 2>&1

# --- nightly Overpass POI upsert (01:00) — schools, labs, greens, restaurants... ---
# SAFE: crawl_pois_vietnam.py upserts (dedup via EXISTS guard), NEVER drops schema
# or wipes user rows. Runs 1h after feature crawlers so the DB is warm. Full-nation
# upsert is idempotent (same POIs re-upserted), so a post-reset DB auto-heals nightly.
0 1 * * * root bash /app/scripts/run_overpass_seed.sh >> /app/crawlers/crawled_data/overpass_crawl.log 2>&1

# --- optional FULL REFRESH (nationwide Overpass + seed rebuild, DROPS schema) ---
# MANUAL / gated only — never auto-run in dev (would wipe user data like
# bookmarks/registrations). Enable explicitly via EDUMAP_FULL_REFRESH=1 in .env
# AND uncomment this line:
# 0 0 * * * root EDUMAP_FULL_REFRESH=1 bash /app/scripts/run_crawl_pipeline.sh >> /app/crawlers/crawled_data/crawl.log 2>&1
