# EduMap — Local Docker Compose Environment Template
# Copy this file to .env and adjust values before running:
#   docker-compose up --build

# --- Database (PostgreSQL in Docker) ---
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=edumap
DB_PASSWORD=edumap_password
DB_DATABASE=edumap_db
DB_TYPE=postgres
DB_SYNC=true

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=change-this-secret-key-in-production
JWT_EXPIRES_IN=7d

# --- Google OAuth ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# --- AI Service (Cloudflare Workers AI) ---
AI_SERVICE_URL=http://ai-service:8000
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3-8b-instruct
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-1280

# --- OSRM Routing ---
OSRM_URL=http://osrm:5000

# --- MinIO (Object Storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Application ---
NODE_ENV=development

# --- External Ports (host) ---
POSTGRES_PORT_EXTERNAL=5433
NGINX_PORT_EXTERNAL=80

# --- Monitoring ---
GRAFANA_PASSWORD=admin_secure_123
