# EduMap — Local Docker Compose Environment Template
# Copy this file to .env and adjust values before running:
#   docker-compose up --build

# --- Database (PostgreSQL in Docker) ---
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=edumap
DB_PASSWORD=edumap_password
DB_DATABASE=edumap_db
DB_TYPE=postgres
DB_SYNC=false

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=change-this-secret-key-in-production
JWT_EXPIRES_IN=7d

# --- Google OAuth ---
# NEXT_PUBLIC_GOOGLE_CLIENT_ID: dùng trong frontend (Next.js) — bị INLINE lúc build,
#   nên trên host chỉ có tác dụng nếu truyền làm build arg. Không bắt buộc.
# GOOGLE_CLIENT_ID: tên SECRET phải dùng trên host (runtime env var), đọc bởi
#   /api/config. Đăng nhập Google dùng GIS `credential` → CHỈ cần client id.
# Các giá trị này là SECRET — thiết lập trong host → Settings → Secrets (không commit vào repo).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
# KHÔNG dùng: GIS/JWT không cần client secret. Login Google do Rust decode
# `credential` (backend/src/modules/auth.rs) → không có bước đổi token.
# Giữ trống để tránh tưởng nhầm là đang bật.
GOOGLE_CLIENT_SECRET=
# --- Google OAuth (KHÔNG dùng — di sản NextAuth) ---
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs

# --- AI Service (DeepSeek = primary text generation) ---
# DEEPSEEK_API_KEY là SECRET — thiết lập trong host → Settings → Secrets.
# DeepSeek dùng API tương thích OpenAI (/chat/completions), đứng đầu chuỗi
# → local multilingual-e5-small (xem vector_store.py).
AI_SERVICE_URL=http://ai-service:8000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat,deepseek-reasoner
DEEPSEEK_TIMEOUT_SECONDS=20


# --- GeoVision AI (Idea #10: satellite imagery school/institution detection) ---
# Zero-shot detection model used on stitched satellite tiles.
GEO_VISION_MODEL=google/owlv2-base-patch16-ensemble
GEO_VISION_TIMEOUT_SECONDS=25
# Bing Maps API key for aerial tile source in GeoVision (optional — esri
# is used as the fallback source).
BING_MAPS_API_KEY=
# Đặt false chỉ khi mạng của bạn thuần IPv6.
AI_FORCE_IPV4=true

# --- Adzuna API (job market data for AI trends — LLM-independent) ---
# If set, market trends analysis pulls live job data from Adzuna.
# If left blank, falls back to local SQLite edumap.db data.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=vn

# --- Ticketmaster API (event discovery — fallback for events list) ---
TICKETMASTER_API_KEY=

# --- VNPay (Sandbox) ---
VNP_TMN_CODE=DEV1234567
VNP_HASH_SECRET=wJ9Q5D2F8K7H3M1N
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3001/donations/callback

# --- Định tuyến (Routing) ---
# Rust backend đọc ROUTING_SERVICE_URL (OSRM/ORS). OSRM_URL là tên cũ của
# NestJS, chỉ còn script cũ dùng — backend Rust KHÔNG đọc OSRM_URL.
ROUTING_SERVICE_URL=http://osrm:5000
OSRM_URL=http://osrm:5000

# --- OpenRouteService (KHÔNG dùng) ---
# Không code nào đọc ORS_API_KEY: định tuyến đi qua ROUTING_SERVICE_URL
# (OSRM public hoặc OSRM trong container). Giữ dòng này chỉ để tham chiếu.
ORS_API_KEY=

# --- MinIO (Object Storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Application ---
NODE_ENV=development
# Dev-login bypass (/api/auth/dev-login). Creates a deterministic dev user
# with a stable UUID so JWTs remain valid across host container restarts
# (where runtime-created Google-login users are wiped but the JWT secret is stable).
# On host this is set to `true` via the Dockerfile ENV.
ENABLE_DEV_LOGIN=false
# Client calls must be same-origin (`/api`). An absolute URL is inlined into
# the browser bundle at build time and breaks when the app is served from a
# different host (e.g. a Docker container or remote VPS).
NEXT_PUBLIC_API_URL=/api
# (DB_SQLITE_PATH removed — Postgres only.)
# Backend base URL used by the Next.js BFF (app/api/*.route.ts) via getBackendUrl().
# host: set via Dockerfile ENV (BACKEND_URL=http://127.0.0.1:3000).
# Docker Compose: frontend service passes BACKEND_URL=http://backend:3000.
BACKEND_URL=http://127.0.0.1:3000
# --- Rust backend (backend/src) ---
# Cổng Rust lắng nghe (NestJS cũ dùng PORT; Rust đọc BACKEND_PORT).
BACKEND_PORT=3000
# Timeout gọi ai-service (giây).
AI_SERVICE_TIMEOUT=45
# Thư mục lưu file upload (thay MinIO).
STORAGE_DIR=/app/uploads
# URL nội bộ để community gửi notification (mặc định http://127.0.0.1:3000/api/notifications/send).
NOTIFICATIONS_URL=http://127.0.0.1:3000/api/notifications/send

# --- Deploy thật: xem deploy/*.env.example ---
# Vercel  → deploy/vercel.env.example
# Render  → deploy/render-api.env.example + deploy/render-ai.env.example
# Bảng đối chiếu đầy đủ: docs/ENV_SYNC.md

# --- Crawler (chỉ có ý nghĩa khi chạy PostgreSQL local hoặc DB riêng) ---
# Đặt =true nếu muốn chạy crawl_jobs.py khi khởi động container (cần mạng)
CRAWL_ON_START=false
# Chu kỳ crawl (giây), mặc định 86400 = 24h
CRAWL_INTERVAL_SECONDS=86400
# Chạy crawler khi container khởi động (best-effort, không wipe data)
EDUMAP_CRAWLER_BOOT_RUN=1

# --- Content / social crawler sources ---
# books_crawler: live OpenLibrary crawl when =1 (else curated snapshot, always available).
EDUMAP_BOOKS_LIVE=0
# social_crawler: Twitter/X v2 bearer token (optional; falls back to Reddit + HN).
TWITTER_BEARER_TOKEN=

# --- Tavily AI Search & Extract (crawlers) ---
# Tavily provides a single HTTPS endpoint reachable from host egress
# (replacing Eventbrite, ITviec, RemoteOK, Remotive, Dev.to, etc.
# which are all blocked on host free tier).
# Đặt vào host → Settings → Secrets. Khi thiếu → crawler trả về 0 dòng (giảm dần).
TAVILY_API_KEY=
# Tavily request timeout (seconds).
TAVILY_TIMEOUT_SECONDS=25
# Max results per Tavily search (default 8 to conserve 1000 free credits/month).
TAVILY_MAX_RESULTS=8
# Circuit breaker: open after N consecutive failures (default 5).
TAVILY_CIRCUIT_BREAKER_FAILURES=5
# Circuit breaker TTL in seconds (default 300 = 5 min).
TAVILY_CIRCUIT_BREAKER_TTL=300
# Optional: full-refresh nationwide POI crawl (DROP SCHEMA) — manual/gated only.
EDUMAP_FULL_REFRESH=0

# --- Gemini API (fallback text generation + embeddings) ────────────────────
# DeepSeek is the primary text-generation provider (DEEPSEEK_API_KEY above).
# Gemini is the first fallback for text, and it still serves embeddings when
# Chỉ dùng các model còn tồn tại (Gemini API, 10/2026). 1.5/2.0 đã bị tắt.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=20
# Embedding time budget (seconds). Keep the whole chain under RAG_TIMEOUT_SECONDS
# so the NestJS stream timeout (10s) is never hit. Per-provider cap prevents
# any single provider from consuming the whole budget and skipping fallbacks.
EMBED_GLOBAL_TIMEOUT_SECONDS=6
EMBED_PROVIDER_TIMEOUT_SECONDS=4
RAG_TIMEOUT_SECONDS=8
# Default 8s — enough for Gemini TCP+TLS connect (~4-6s) + response,
# while staying under the NestJS 10s proxy deadline.
GEN_TIMEOUT_SECONDS=8

# --- Voice-to-Geo (Idea #16: Speech-to-Text) ────────────────────────────────
# On host free plan, no server-side STT provider is configured.
# The service degrades to client-side Web Speech API (audio captured in-browser,
# never sent to a server — privacy-first).
# If a server-side STT provider is added later, set the key/model below.
STT_TIMEOUT_SECONDS=25

# --- Edge AI Tutor (Idea #7) ---
# No local model is bundled: the tutor uses the shared text cascade
# Set to "false" to force template-only answers (instant, no network call).
OFFLINE_TUTOR_USE_LLM=true

# --- External Ports (host) ---
POSTGRES_PORT_EXTERNAL=5433
NGINX_PORT_EXTERNAL=80

# --- Monitoring ---
GRAFANA_PASSWORD=admin_secure_123
