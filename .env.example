# EduMap Environment Configuration Template

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=password123
DB_DATABASE=edumap_db
DB_TYPE=postgres
DB_SYNC=false
DB_SQLITE_PATH=:memory:

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
CHROMA_DB_PATH=./chroma_db

# OSRM Routing Configuration
OSRM_URL=http://localhost:5000

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=noreply@edumap.vn

# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Sentry (Optional)
SENTRY_DSN_BACKEND=

# External Ports (for docker-compose)
POSTGRES_PORT_EXTERNAL=5433
NGINX_PORT_EXTERNAL=7860
PROMETHEUS_PORT_EXTERNAL=9090

# Notes for Hugging Face Deployment:
# For HF Spaces, set GEMINI_API_KEY as a secret environment variable
# The AI Service will automatically connect to the database via internal network