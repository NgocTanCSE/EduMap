# EduMap — Local Docker Compose Environment Template
# Copy this file to .env and adjust values before running:
#   docker-compose up --build

# --- Database (PostgreSQL in Docker) ---
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=edumap
DB_PASSWORD=edumap_password
DB_DATABASE=edumap_db
DB_TYPE=postgres
DB_SYNC=true

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=change-this-secret-key-in-production
JWT_EXPIRES_IN=7d

# --- Google OAuth ---
# NEXT_PUBLIC_GOOGLE_CLIENT_ID: dùng trong frontend (Next.js) — bị INLINE lúc build,
#   nên trên HF Spaces chỉ có tác dụng nếu truyền làm build arg. Không bắt buộc.
# GOOGLE_CLIENT_ID: tên SECRET phải dùng trên HF Spaces (runtime env var), đọc bởi
#   /api/config và backend (NestJS). Chỉ cần biến này là đủ.
# Các giá trị này là SECRET — thiết lập trong HF Spaces → Settings → Secrets (không commit vào repo).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# --- Google OAuth (đầy đủ, cần cho Google Cloud Console project) ---
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs

# --- AI Service (Cloudflare Workers AI) ---
# CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID là SECRET — thiết lập trong HF Spaces Secrets.
AI_SERVICE_URL=http://ai-service:8000
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8,@cf/google/gemma-7b-it-lora,@cf/mistralai/mistral-small-3.1-24b-instruct
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5,@cf/baai/bge-m3,@cf/qwen/qwen3-embedding-0.6b

# --- Cloudflare AI Gateway (tuỳ chọn) ---
# Để dùng AI Gateway (caching, rate limiting, observability trên Cloudflare Dashboard):
#   1. Tạo Gateway tại https://dash.cloudflare.com/ → AI → AI Gateway
#   2. Lấy Gateway ID, điền vào CF_AI_GATEWAY_ID
#   3. Đặt CF_AI_GATEWAY_ENABLED=true
# Nếu bỏ trống hoặc =false → gọi trực tiếp Workers AI (mặc định, an toàn).
CF_AI_GATEWAY_ID=
CF_AI_GATEWAY_ENABLED=false

# --- HuggingFace Inference API fallback (khi Cloudflare không kết nối được) ---
# Token phải có quyền "Make calls to Inference Providers" (HF → Settings → Access Tokens).
# HF đã khai tử api-inference.huggingface.co; code dùng router.huggingface.co.
HF_TOKEN=
HF_API_TOKEN=
HF_ROUTER_URL=https://router.huggingface.co
HF_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-base

# --- GeoVision AI (Idea #10: satellite imagery school/institution detection) ---
# HuggingFace Inference API model used for zero-shot object detection on stitched
# satellite tiles. The model runs on HF's servers (NOT bundled in Docker).
GEO_VISION_MODEL=facebook/owlv2-base-c
GEO_VISION_TIMEOUT_SECONDS=25
# Bing Maps API key for aerial tile source in GeoVision (optional — OSM tiles
# are used as fallback when this is not set). Set as HF Spaces Secret.
BING_MAPS_API_KEY=
# HF Spaces có thể bị IPv6 blackhole khiến TLS handshake tới Cloudflare timeout.
# Đặt false chỉ khi mạng của bạn thuần IPv6.
AI_FORCE_IPV4=true

# --- Adzuna API (job market data for AI trends — LLM-independent) ---
# If set, market trends analysis pulls live job data from Adzuna.
# If left blank, falls back to local SQLite edumap.db data.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=vn

# --- Ticketmaster API (event discovery — fallback for events list) ---
TICKETMASTER_API_KEY=

# --- VNPay (Sandbox) ---
VNP_TMN_CODE=DEV1234567
VNP_HASH_SECRET=wJ9Q5D2F8K7H3M1N
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3001/donations/callback

# --- OSRM Routing ---
OSRM_URL=http://osrm:5000

# --- OpenRouteService (geocoding/routing) — used by backend map/routing.service ---
# Optional: leave blank to use OSRM instead. Get a free key at
# https://openrouteservice.org/ (được liệt kê trong secrets của HF Spaces).
ORS_API_KEY=

# --- MinIO (Object Storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Application ---
NODE_ENV=development
# Dev-login bypass (/api/auth/dev-login). Enabled automatically in
# development; in production it is disabled unless explicitly set to true.
ENABLE_DEV_LOGIN=false
# Client calls must be same-origin (`/api`). An absolute URL is inlined into
# the browser bundle at build time and breaks when the app is served from a
# different host (e.g. Hugging Face Spaces).
NEXT_PUBLIC_API_URL=/api
DB_SQLITE_PATH=/app/frontend/public/edumap.db
# Backend base URL used by the Next.js BFF (app/api/*.route.ts) via getBackendUrl().
# HF Spaces: set via Dockerfile ENV (BACKEND_URL=http://127.0.0.1:3000).
# Docker Compose: frontend service passes BACKEND_URL=http://backend:3000.
BACKEND_URL=http://127.0.0.1:3000

# --- Crawler (chỉ có ý nghĩa khi chạy PostgreSQL local hoặc DB riêng) ---
# Đặt =true nếu muốn chạy crawl_jobs.py khi khởi động container (cần mạng)
CRAWL_ON_START=false
# Chu kỳ crawl (giây), mặc định 86400 = 24h
CRAWL_INTERVAL_SECONDS=86400
# Chạy crawler khi container khởi động (best-effort, không wipe data)
EDUMAP_CRAWLER_BOOT_RUN=1

# --- Content / social crawler sources ---
# books_crawler: live OpenLibrary crawl when =1 (else curated snapshot, always available).
EDUMAP_BOOKS_LIVE=0
# social_crawler: Twitter/X v2 bearer token (optional; falls back to Reddit + HN).
TWITTER_BEARER_TOKEN=
# Optional: full-refresh nationwide Overpass (DROP SCHEMA) — manual/gated only.
EDUMAP_FULL_REFRESH=0

# --- XKIRO API (primary LLM provider for text generation) ---
# Dùng cho chat, learning-path, career recommendation, library summary...
# XKIRO_API_KEY là SECRET — thiết lập trong HF Spaces → Settings → Secrets.
XKIRO_API_KEY=
XKIRO_MODEL=google/gemini-3.8-flash
# XKIRO_EMBEDDING_MODEL — XKIRO does NOT support embeddings (/v1/embeddings
# returns 404). Leave empty so the embedding chain falls through to
# Gemini / HuggingFace / NVIDIA / Kimi. This var is kept for forward compatibility.
XKIRO_EMBEDDING_MODEL=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_TIMEOUT_SECONDS=8
# Embedding budget (seconds). Keep RAG_TIMEOUT_SECONDS < 10 so the NestJS
# stream timeout is never hit. Per-provider cap prevents any single provider
# from consuming the whole budget and skipping fallbacks.
EMBED_GLOBAL_TIMEOUT_SECONDS=6
EMBED_PROVIDER_TIMEOUT_SECONDS=4
RAG_TIMEOUT_SECONDS=8

# --- XKIRO Speech-to-Text (Voice-to-Geo AI — Idea #16) ---
# Server-side STT fallback (Whisper) when the browser Web Speech API
# mis-transcribes Vietnamese. Used by POST /api/ai/speech/to-text.
# NOTE: XKIRO does NOT natively support speech-to-text (/audio/transcriptions
# returns 404). Leave XKIRO_STT_MODEL empty to degrade to client-side Web Speech
# API. The service still attempts the XKIRO endpoint if a model is configured
# and falls through gracefully on failure.
XKIRO_STT_MODEL=
XKIRO_STT_TIMEOUT_SECONDS=25

# --- NVIDIA NIM (secondary LLM provider, tuỳ chọn) ---
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=meta/llama-3.1-8b-instruct

# --- Shanghai AI Laboratory (01.ai / Kimi) — secondary LLM provider ---
# Set KIMI_API_KEY as an HF Spaces Secret to enable Kimi as a fallback provider.
# 01.ai API is OpenAI-compatible (https://api.01.ai/v1).
# kore-gpt-9b is the Kimi chat model; kimi-embedding-0812 (768-dim) is the
# embedding model, compatible with Gemini/XKIRO embeddings dimension.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.01.ai/v1
KIMI_MODEL=kore-gpt-9b
KIMI_EMBEDDING_MODEL=kimi-embedding-0812
KIMI_TIMEOUT_SECONDS=30

# --- Gemini API (embeddings + last-resort fallback text generation) ---
# Không còn là provider chính cho text generation. Chỉ dùng cho embeddings
# (vector_store.py) và làm fallback cuối cùng nếu XKIRO/NVIDIA/CF/HF đều fail.
GEMINI_API_KEY=
# Chỉ dùng các model còn tồn tại (Gemini API, 10/2026). 1.5/2.0 đã bị tắt.
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=20

# --- Edge AI Tutor (offline LLM, Idea #7) ---
# TinyLlama 1.1B runs locally in the ai-service container — NO external API calls.
# Model is downloaded at runtime from HF Hub to OFFLINE_MODEL_CACHE (writable).
# On HF Spaces free plan, model weights are NOT in the Docker image.
OFFLINE_MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0
OFFLINE_MODEL_CACHE=/app/uploads/offline-models
# Set to "false" to force template-based fallback (no local model).
OFFLINE_MODEL_ENABLED=true

# --- External Ports (host) ---
POSTGRES_PORT_EXTERNAL=5433
NGINX_PORT_EXTERNAL=80

# --- Monitoring ---
GRAFANA_PASSWORD=admin_secure_123
